# Python
.venv/
__pycache__/
*.pyc

# PlatformIO build output (regenerated by `pio run`)
firmware/.pio/

# Webcam + mapping working files (huge, machine-specific, not source)
mapping/cam/
mapping/captures/
mapping/captures2/
mapping/captures3/
*.mp4
*.jpg
*.jpeg
*.png

# macOS
.DS_Store

# Local logs
*.log

# Your own stock firmware dump: proprietary, and contains the device's saved
# WiFi credentials. Never commit it.
wfd2-stock-*.bin

# Built by install.sh from wfd2-launcher.c
WFD2Clock.app/

# Off switch for the Claude usage grid (./wfd2-usage off)
claude-usage.off
# Throttle stamp for the login renewal (mac/claude_usage.py)
.claude-usage-last-renew
